# =============================================================================
# daily-brief Python environment configuration
# =============================================================================
# Copy this file to .env.local and edit it. .env.local is gitignored.

# -----------------------------------------------------------------------------
# LLM backend selector
# -----------------------------------------------------------------------------
# claude-cli   - spawn local `claude` binary, billed against Max subscription
# anthropic    - Anthropic Messages API
# openai       - OpenAI Chat Completions API
# deepseek     - DeepSeek OpenAI-compatible API
# minimax      - MiniMax OpenAI-compatible API
# zhipu        - Zhipu Anthropic-compatible API
#
# Default: claude-cli
# LLM_BACKEND=claude-cli

# Universal model override. If set, it applies to the active backend.
# LLM_MODEL=

# Generic aliases for OpenAI/Anthropic-compatible providers.
# Provider-specific variables below take precedence.
# LLM_API_KEY=
# LLM_BASE_URL=

# -----------------------------------------------------------------------------
# Backend: claude-cli
# -----------------------------------------------------------------------------
# CLAUDE_CLI_PATH=
# CLAUDE_MODEL=sonnet

# -----------------------------------------------------------------------------
# Backend: anthropic
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=
# LLM_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Backend: openai
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Backend: deepseek
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash

# -----------------------------------------------------------------------------
# Backend: minimax
# -----------------------------------------------------------------------------
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# LLM_MODEL=MiniMax-M2.7

# -----------------------------------------------------------------------------
# Backend: zhipu
# -----------------------------------------------------------------------------
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/anthropic
# LLM_MODEL=claude-sonnet-4-6

# =============================================================================
# Report locale and timezone
# =============================================================================
# REPORT_LOCALE=zh
# REPORT_TZ=Asia/Shanghai

# =============================================================================
# Production live gate
# =============================================================================
# `dailybrief run` defaults to dry-run planning. A real production run requires
# both `--live --confirm-live` and this env gate.
#
# DAILYBRIEF_LIVE_ALLOWED=false

# =============================================================================
# Output formats
# =============================================================================
# HTML, JSON, and articles sidecar are always written:
#   daily_reports/<date>/<date>.html
#   daily_reports/<date>/<date>.json
#   daily_reports/<date>/<date>-articles.json
#
# OUTPUT_MARKDOWN=true
# DAILYBRIEF_REPORT_BASE_URL=http://149.28.156.116/brief/
# DAILYBRIEF_REPORTS_TARGET=/opt/research-stack/runtime/dailybrief-reports

# =============================================================================
# Optional server deploy
# =============================================================================
# If both are set, `dailybrief deploy` uploads the selected report and refreshes
# remote index.html. `dailybrief run-scheduled` runs deploy after a successful
# daily run; deploy failures are non-fatal.
#
# DEPLOY_HOST=ubuntu@1.2.3.4
# DEPLOY_PATH=/var/www/daily.example.com

# =============================================================================
# Optional notification summaries
# =============================================================================
# `dailybrief notify` and `dailybrief run --send` default to dry-run/no-send.
# Live sending also requires `--confirm-send`.
#
# DAILYBRIEF_REPORT_BASE_URL=https://example.com
#
# SLACK_ENABLED=false
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_CHANNEL=
# SLACK_MESSAGE_MAX_CHARS=3500
# SLACK_TIMEOUT_SECONDS=10
#
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_PARSE_MODE=
# TELEGRAM_MESSAGE_MAX_CHARS=3500
# TELEGRAM_TIMEOUT_SECONDS=10
#
# EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
# EMAIL_TO=
# EMAIL_CC=
# EMAIL_BCC=

# =============================================================================
# Vultr/systemd defaults
# =============================================================================
# The unit files in deploy/vultr/ use:
#   /home/deploy/DailyBrief
#   /etc/dailybrief/dailybrief.env
#   dailybrief run --live --confirm-live --build-site --output-json

# =============================================================================
# GitHub Actions schedule variables
# =============================================================================
# These are usually set as repository variables, not in .env.local:
#
# REPORT_HOUR=8
# REPORT_DAYS=*
